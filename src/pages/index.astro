---
import Portfolio from '../components/Portfolio.jsx';
import { SITE } from '../data/site.js';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const title = `${SITE.name} · Data & AI Engineer`;
const description = 'Data & AI Engineer · Project lead. Building AI tools that turn data into working software. Tenerife, Canary Islands.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#1c1a17" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Figtree:wght@400;500;600;700&family=Kalam:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline src={`${base}notebook-sketches.js`}></script>
    <script is:inline>
      // Aplica el tema guardado antes de pintar para evitar un parpadeo
      try { var th = localStorage.getItem('theme'); if (th) document.documentElement.dataset.themeInit = th; } catch (e) {}
    </script>
  </head>
  <body data-theme="dark" data-motion="on">
    <script is:inline>
      try { var th2 = localStorage.getItem('theme'); if (th2) document.body.dataset.theme = th2; } catch (e) {}
    </script>
    <Portfolio client:load />
  </body>
</html>
